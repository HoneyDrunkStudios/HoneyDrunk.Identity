<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HoneyDrunk.Identity.Api\HoneyDrunk.Identity.Api.csproj" />
    <ProjectReference Include="..\HoneyDrunk.Identity.Client\HoneyDrunk.Identity.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.5.96" />
    <ProjectReference Include="../HoneyDrunk.Identity.Database/HoneyDrunk.Identity.Database.sqlproj" ReferenceOutputAssembly="false" />
    <None Include="../HoneyDrunk.Identity.Database/bin/$(Configuration)/HoneyDrunk.Identity.Database.dacpac" Link="HoneyDrunk.Identity.Database.dacpac" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
